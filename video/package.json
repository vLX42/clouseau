{
  "name": "clouseau-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "build": "remotion render src/index.ts ClouseauExplainer out/clouseau.mp4",
    "build:playback": "remotion render src/index.ts DemoPlayback out/demo-playback.mp4",
    "events": "node scripts/build-events.mjs",
